; Engine configuration file.
; Framewrack — dark industrial inventory roguelike (Backpack Hero–like)
; Godot 4.3+

config_version=5

[application]

config/name="Framewrack"
config/description="Dark industrial body-horror inventory roguelike. Your backpack is your body."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/global/event_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.101961, 0.101961, 0.101961, 1)
